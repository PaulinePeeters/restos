# ====================================================
# RestOS — Configuration Backend
# ====================================================

# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/restos?schema=public"

# Secret JWT (clé secrète pour signer les tokens)
JWT_SECRET=""

# Port du serveur backend
PORT=4000

# URL de base de l'API (décommenter en production)
# BASE_URL=https://api.monrestaurant.com

# URL du frontend (pour les liens dans les emails, etc.)
# FRONTEND_URL=https://monrestaurant.com

# Origines CORS autorisées (décommenter en production)
# CORS_ORIGINS=https://monrestaurant.com,https://www.monrestaurant.com

# SMTP (emails réels)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=declinaisonrestos@gmail.com
SMTP_PASS=mdp

# Expéditeur affiché
MAIL_FROM_NAME=Declinaison
MAIL_FROM_ADDRESS=declinaisonrestos@gmail.com

# Destinataire des formulaires de contact
CONTACT_RECIPIENT_EMAIL=declinaisonrestos@gmail.com
